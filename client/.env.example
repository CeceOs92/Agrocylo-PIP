# Soroban RPC URL for the Stellar network connection
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Passphrase of the target Stellar network (e.g. Test SDF Network ; September 2015)
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8080

# Contract ID for the Production Escrow Smart Contract
VITE_PRODUCTION_ESCROW_CONTRACT_ID=CD...

# Contract ID for the Registry Smart Contract
VITE_REGISTRY_CONTRACT_ID=CD...
